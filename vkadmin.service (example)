[Unit]
Description=vkadmin-bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/ваш_пользователь/telegram-antispam-bot
ExecStart=/usr/bin/dotnet /home/ваш_пользователь/имя_папки/vk-forwarder.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
User=ваш_пользователь
Environment=TG_BOT_TOKEN=Токен вашего бота телеграм -> @BotFather
Environment=TG_ADMIN_ID=Ваш id -> можно узнать через @Getmyid_bot
Environment=VK_GROUP_TOKEN=Токен ВКонтакте Группа
Environment=VK_GROUP_ID=id вашей группы ВКонтакте (только цифры)

[Install]
WantedBy=multi-user.target
